*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
MODULE pbo_0100 OUTPUT.
  SET PF-STATUS 'S100'.
  SET TITLEBAR 'T100' WITH gr_data->mf_title.

  LOOP AT SCREEN.
    CASE screen-group1.
      WHEN 'TIM'.
        screen-active = gr_data->is_time_of_day_required( ).
    ENDCASE.
    MODIFY SCREEN.
  ENDLOOP.

ENDMODULE.
